generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Owner {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  businesses   Business[]
  createdAt    DateTime   @default(now())
}

model Category {
  id         String     @id @default(cuid())
  slug       String     @unique
  name       String
  tag        String?
  businesses Business[]
}

model Business {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  hours       String
  phone       String
  whatsapp    String?
  area        String
  services    String[]
  category    Category @relation(fields: [categoryId], references: [id])
  categoryId  String
  owner       Owner?   @relation(fields: [ownerId], references: [id])
  ownerId     String?
  photos      Photo[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Photo {
  id         String   @id @default(cuid())
  url        String
  order      Int      @default(0)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
}
